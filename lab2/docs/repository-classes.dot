digraph G {
 graph [fontname="Liberation Sans", rankdir=BT, ranksep=0.6, nodesep=0.5, ranksep=0.7, dpi=200, bgcolor="white"];
 node [shape=plaintext, fontname="Liberation Sans", fontsize=11];
 edge [fontname="Liberation Sans", fontsize=10];
 IRepository [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8EEF7"><B><FONT POINT-SIZE="9">«interface»</FONT><BR/>IRepository&lt;T&gt;</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ GetById(id): T?<BR/>+ GetAll(): IEnumerable&lt;T&gt;<BR/>+ Add(entity), Update(entity)<BR/>+ Delete(id): bool<BR/>+ GetByIdAsync, GetAllAsync,<BR/>   AddAsync, DeleteAsync</TD></TR></TABLE>>];
 IBookRepository [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8EEF7"><B><FONT POINT-SIZE="9">«interface»</FONT><BR/>IBookRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ GetByAuthor(authorId)<BR/>+ GetByPriceRange(min, max)<BR/>+ SearchByTitle(fragment)<BR/>+ GetPublishedAfterAsync(year)</TD></TR></TABLE>>];
 IAuthorRepository [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8EEF7"><B><FONT POINT-SIZE="9">«interface»</FONT><BR/>IAuthorRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ GetWithBooks(id)<BR/>+ FindByName(namePart)</TD></TR></TABLE>>];
 Generic [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8EEF7"><B>GenericRepository&lt;T&gt;</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># Context: DbContext<BR/># Set: DbSet&lt;T&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ CRUD (синхр. и асинхр.)</TD></TR></TABLE>>];
 BookRepository [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8EEF7"><B>BookRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ запросы по книгам</TD></TR></TABLE>>];
 AuthorRepository [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8EEF7"><B>AuthorRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ запросы по авторам</TD></TR></TABLE>>];
 IUoW [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8EEF7"><B><FONT POINT-SIZE="9">«interface»</FONT><BR/>IUnitOfWork</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Books: IBookRepository<BR/>+ Authors: IAuthorRepository<BR/>+ SaveChanges(), SaveChangesAsync()<BR/>+ Rollback()</TD></TR></TABLE>>];
 UoW [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8EEF7"><B>UnitOfWork</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _context: LibraryDbContext</TD></TR></TABLE>>];
 Ctx [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#FFF4E0"><B>LibraryDbContext</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Authors: DbSet&lt;Author&gt;<BR/>+ Books: DbSet&lt;Book&gt;</TD></TR></TABLE>>];
 IBookRepository -> IRepository [arrowhead=onormal]; IAuthorRepository -> IRepository [arrowhead=onormal]; Generic -> IRepository [style=dashed, arrowhead=onormal];
 BookRepository -> Generic [arrowhead=onormal]; AuthorRepository -> Generic [arrowhead=onormal]; BookRepository -> IBookRepository [style=dashed, arrowhead=onormal]; AuthorRepository -> IAuthorRepository [style=dashed, arrowhead=onormal];
 UoW -> IUoW [style=dashed, arrowhead=onormal]; UoW -> BookRepository [dir=back, arrowtail=diamond, label=" создаёт"]; UoW -> AuthorRepository [dir=back, arrowtail=diamond]; 
 Generic -> Ctx [style=dotted, arrowhead=vee, constraint=false]; UoW -> Ctx [style=dotted, arrowhead=vee, label=" владеет"];
}
