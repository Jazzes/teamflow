<?xml version="1.0" encoding="utf-8"?>
<!-- Настройки coverlet.collector для dotnet test --collect и для IDE (Rider, Visual Studio, VS Code) -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Users.Core]*,[Users.Data]*,[Users.Api]*</Include>
          <ExcludeByFile>**/Program.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
